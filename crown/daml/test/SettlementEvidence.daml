module SettlementEvidence where

import Daml.Script
import Repo.Agreement
import Settlement
import Types

validTerms : Party -> RepoTerms
validTerms approver =
  RepoTerms with
    productType = "BilateralRepo"
    marketConventionId = "M-0001"
    principal = 1000000.00
    currency = "USD"
    repoRate = 0.05
    rateType = Fixed
    dayCountConvention = Actual360
    tradeDate = date 2026 Jan 1
    openingValueDate = date 2026 Jan 2
    maturityDate = date 2026 Jan 9
    applicableCalendar = "TARGET"
    repurchaseAmount = 1005000.00
    collateralBasketId = None
    eligibleAssetClasses = [GovernmentBond]
    collateralCurrency = "USD"
    haircut = 0.02
    concentrationLimit = 0.20
    marginFrequencyDays = 0
    marginThreshold = 0.01
    minimumTransferAmount = 100.00
    disputeWindowHours = 24
    settlementSystemId = "CCIL"
    settlementCutOffTime = "14:30:00Z"
    masterAgreementRef = "GMRA-2011"
    legalEntityIdBorrower = "LEI-BORROWER"
    legalEntityIdProvider = "LEI-LENDER"
    termsVersion = 1
    approvedBy = approver

-- Settlement instructions must carry a positive amount and a stable idempotency key.
testSettlementInstructionRejectsNonPositiveAmount : Script ()
testSettlementInstructionRejectsNonPositiveAmount = do
  borrower <- allocateParty "Borrower"
  cashProvider <- allocateParty "CashProvider"
  settlementRole <- allocateParty "SettlementAgent"
  now <- getTime

  submitMustFail borrower do
    createCmd SettlementInstruction with
      instructionId = "settlement-invalid-001"
      agreementId = "agreement-001"
      borrower = borrower
      cashProvider = cashProvider
      settlementRole = settlementRole
      legType = CashLeg
      amount = 0.0
      currency = "USD"
      instrumentId = None
      debitAccount = "DEBIT-001"
      creditAccount = "CREDIT-001"
      settlementSystem = "CCIL"
      valueDate = "2026-01-02"
      status = Prepared
      idempotencyKey = "settlement-invalid-001"
      requestedAt = now
      externalRef = None

  pure ()

-- A repo agreement cannot request opening settlement before the agreement is accepted.
testOpeningSettlementRequiresAcceptedStatus : Script ()
testOpeningSettlementRequiresAcceptedStatus = do
  borrower <- allocateParty "Borrower"
  cashProvider <- allocateParty "CashProvider"
  now <- getTime

  agreement <- submitMulti [borrower, cashProvider] [] do
    createCmd RepoAgreement with
      agreementId = "agreement-opening-invalid"
      borrower = borrower
      cashProvider = cashProvider
      terms = validTerms borrower
      status = Proposed
      createdAt = now
      activatedAt = None
      closedAt = None

  submitMustFailMulti [borrower, cashProvider] [] do
    exerciseCmd agreement RequestOpeningSettlement with
      settlementSystemId = "CCIL"

  pure ()
