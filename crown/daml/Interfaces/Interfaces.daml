-- | Crown.Interfaces
-- Adapter boundary interfaces for settlement, custody and pricing adapters.
-- Architecture §9.1, §3.1
module Interfaces where

import DA.Time (Time)

-- ---------------------------------------------------------------------------
-- AdapterRequest (outbox record submitted to adapter workers)
-- ---------------------------------------------------------------------------

-- | An outbox record for a pending adapter request.
-- Architecture §9.2: transactional outbox pattern.
-- The idempotency key must be derived from a stable business identifier.
data AdapterRequest = AdapterRequest
  with
    requestId      : Text    -- stable business identifier for this request
    adapterName    : Text    -- e.g. "PaymentAdapter" | "CustodyAdapter" | "PricingAdapter"
    operationType  : Text    -- e.g. "submitInstruction" | "getStatus" | "verifyEvidence"
    payloadHash    : Text    -- SHA-256 of the request payload
    idempotencyKey : Text    -- stable key; NOT random on every retry
    attemptCount   : Int     -- number of times this request has been attempted
  deriving (Eq, Show)

-- ---------------------------------------------------------------------------
-- AdapterOutboxEntry (contract)
-- ---------------------------------------------------------------------------

-- | `AdapterOutboxEntry` — an on-ledger outbox record that triggers the
-- adapter worker to make an external call.
-- Architecture §9.2: use an idempotency key derived from a stable business
-- identifier, not a random new key on every retry.
template AdapterOutboxEntry
  with
    entryId        : Text
    agreementId    : Text
    requestingParty: Party              -- the party that triggered the adapter call
    counterparty   : Party              -- observer for transparency
    adapterName    : Text
    operationType  : Text
    payloadRef     : Text               -- reference to the actual payload (not payload itself)
    idempotencyKey : Text
    status         : Text               -- "Pending" | "Submitted" | "Completed" | "Failed" | "DeadLettered"
    attemptCount   : Int
    createdAt      : Time
    lastAttemptAt  : Optional Time
  where
    signatory requestingParty
    observer counterparty

    ensure
      entryId /= ""
      && idempotencyKey /= ""
      && attemptCount >= 0

    -- | Adapter worker marks entry as submitted to the external system.
    choice MarkSubmitted : ContractId AdapterOutboxEntry
      with externalRequestRef : Text
      controller requestingParty
      do
        assertMsg "Entry must be Pending to be marked Submitted"
          (status == "Pending")
        now <- getTime
        create this with
          status        = "Submitted"
          attemptCount  = attemptCount + 1
          lastAttemptAt = Some now

    -- | Adapter worker marks entry as successfully completed.
    choice MarkCompleted : ()
      with responseRef : Text
      controller requestingParty
      do
        assertMsg "Entry must be Submitted to be marked Completed"
          (status == "Submitted")
        return ()

    -- | Adapter worker marks a transient failure; may be retried.
    choice MarkFailed : ContractId AdapterOutboxEntry
      with failureReason : Text
      controller requestingParty
      do
        create this with
          status = "Failed"

    -- | After retry limit exceeded, dead-letter the entry for manual review.
    choice DeadLetter : ()
      with reason : Text
      controller requestingParty
      do
        assertMsg "Entry must be in Failed state to be dead-lettered"
          (status == "Failed")
        return ()
